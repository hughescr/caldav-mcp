# Local development settings only.
# Credentials, app-specific passwords and key material NEVER go in this file
# (or in any file committed to git).
PORT=3000
# Leave the values below unset for safe local smoke checks (readiness/MCP return 503, no AWS calls).
# Production imports its canonical origin from bootstrap; this override is local only.
# PUBLIC_BASE_URL=https://your-canonical-service-origin.example
# CREDENTIAL_TABLE_NAME=caldav-mcp-prod-state
# AUTH_KEYRING_PARAMETER=/caldav-mcp/prod/auth-keyring
# Comma-separated account hashes produced by `bun run apple-id-hash`.
# Empty or unset means nobody can connect (fail closed).
# ALLOWED_APPLE_ID_HASHES=
